        var spGiraPuerta1 = document.getElementById('spanIn');
        var spGiraPuerta2 = document.getElementById('spanOut');
        var botonPortonIn = document.getElementById('btnIn');
        var botonPortonOut = document.getElementById('btnOut');
        // Configura el cliente MQTT
        var client = mqtt.connect('ws://emqx.aysafi.com:8083/mqtt', {
            clientId: 'cliente-web'
        });

        // Suscríbete al tópico '/comando'
        client.on('connect', function () {
            console.log('Conexión exitosa al servidor MQTT');
            client.subscribe('/comando', function (err) {
                if (!err) {
                    console.log('Suscripción exitosa al tópico /comando');
                }
            });
        });
    
        // Maneja el mensaje recibido en el tópico
        client.on('message', function (topic, message) {
            // Aquí puedes manejar la lógica cuando llegue un mensaje al tópico
            var msg = message.toString();
            console.log('Mensaje recibido en el tópico ' + topic + ': ' + msg);
            if(msg == 'Puerta 1'){
                console.log("Puerta 1 Moviéndose");
                spGiraPuerta1.className= 'spinner-border spinner-border text-danger';
                botonPortonIn.disabled = true;
                setTimeout(function(){
                    spGiraPuerta1.className = 'none';
                    console.log("Puerta 1 Cerrada");
                    botonPortonIn.disabled = false;
                }, 30000);
            }else if(msg == 'Puerta 2'){
                console.log("Puerta 2 Moviéndose");
                spGiraPuerta2.className= 'spinner-border spinner-border text-danger';
                botonPortonOut.disabled = true;
                setTimeout(function(){
                    spGiraPuerta2.className = 'none';
                    console.log("Puerta 2 Cerrada");
                    botonPortonOut.disabled = false;
                }, 30000);
            }
        });



        function execDoor(door){
            if(door == 'Input'){
                console.log("Entrada Presionada");
                //socket.emit('/testTopic', 'Rele 1 Pulsado');
                client.publish('/testTopic', 'Rele 1 Pulsado');
            }else if(door== 'Output'){
                console.log("Salida Presionada");
                client.publish('/testTopic', 'Rele 2 Pulsado');
            }
    
        }
    

    
</script>

</body>
</html>