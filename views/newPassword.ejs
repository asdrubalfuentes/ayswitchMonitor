        function onload(){
            const token = document.URL.substr(document.URL.indexOf('=')+1);
            console.log(token);  
            const inputToken = document.getElementById('token');
            inputToken.value = token;
        }

        const formEditar = document.querySelector('#formConfirmPassword');

        /*function decodeJWT(token) {
            return JSON.parse(token.from(token.split('.')[1], 'base64').toString());
        }*/

        function decodeJWT(token) {
            const base64Url = token.split('.')[1];
            const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            const jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));
            return JSON.parse(jsonPayload);
        }

        formEditar.addEventListener('submit', async(e) => {
            e.preventDefault()
            // Alternativa #1 (capturar input)
            const passwd = document.querySelector('#pass1').value
            // Alternativa #2 (capturar input)
            const repasswd = document.querySelector('#pass2').value


            const token = document.querySelector('#token').value
            user = decodeJWT(token);
            const id = user.id

            const data = await fetch(`/api/user/newpassword/${id}`, {
                method: 'PUT',
                headers: {
                'Content-Type': 'application/json'
                // 'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: JSON.stringify({passwd, repasswd, id})
            })

            const res = await data.json()

            if(res.error==null){
                window.location.href = '/api/user/login'
                console.log(res)
            }else{
                console.log(res.error)
            }

        })


        function revisaSimilar(){
            var password1 = document.getElementById('pass1');
            var password2 = document.getElementById('pass2');
            if (password1.value != password2.value) {
                //password2.className['was-validated'] = false;
                console.log("Valido = ", "falso");
                password2.className = "form-control is-invalid"
            }else{
                //password2.className['was-validated']  = true;
                console.log("Valido = ", "Verdadero");
                password2.className = "form-control is-valid"
            }
 
        }
    
    
    </script>
    
