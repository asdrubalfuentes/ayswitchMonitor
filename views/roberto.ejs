<body class="bg-light text-yellow text-center shadow-lg">

<div class="container-fluid p-5 bg-light text-primary text-center shadow-lg">
  <h1>Hola, <%=user.name%></h1>
  <p class= "text-danger-emphasis">Pinche Solo Una Vez el Botón Correspondiente a la Corredera de Salida o de Entrada</p>
</div>
  
<div class="container-fluid p-5 bg-light text-Grey text-center shadow-lg">
  <div class="row" >
    <div class="col-sm-4">

    </div>
    <div class="col-sm-4">
        <div class="row">
            <h7>Portón de Entrada al Condominio</h7>
            <br>
            <!---<button type="button" class="btn btn-success" id="btnIn" style="box-shadow: 2px 2px 2px 2px rgb(45, 46, 49);"><strong>Pulse Para Entrar</strong></button>--->
            <button type="button" class="h-75 btn btn-outline-info shadow-lg rounded-5 " id="btnIn" onclick="execDoor('Input');">
                <span class="none" id="spanIn"></span>  
                <h2 id="txtbtnIn">Pulse Para Entrar</h2>
            </button>
        </div>
        <div class="row">
            <br>
            <br>
        </div>
        <div class="row">
            <h7>Portón de Salida del Condominio</h7>
            <br>
            <!---<button type="button" class="btn btn-danger" id="btnOut" style="box-shadow: 2px 2px 2px 2px rgb(38, 39, 44);"><strong>Pulse Para Salir</strong> </button>--->
            <button type="button" class="h-75 btn btn-outline-warning shadow-lg rounded-5" id="btnOut" onclick="execDoor('Output');">
                <span class="none"  id="spanOut"></span> 
                <h2 id="txtbtnOut">Pulse Para Salir</h2>
            </button>       
        </div>

    </div>
    <div class="col-sm-4">
    </div>
  </div>
</div>
<div class="mt-4 p-5 bg-LightGrey text-info rounded">
    <!---<h1>Aysafi</h1>
    <p class="text-warning">Sistemas electrónicos...</p>--->
    <img src="/static/LOGO.png?auth_token=<%=token%>" alt="" >
</div>

<script>
