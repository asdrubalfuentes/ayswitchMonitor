<%
  const nombre = String(user.name || '').trim();
  const iniciales = nombre.split(/\s+/).filter(Boolean).slice(0, 2).map(function (p) { return p[0].toUpperCase(); }).join('') || '?';
%>
<button class="btn btn-light border shadow-sm rounded-circle" type="button"
        data-bs-toggle="offcanvas" data-bs-target="#menuLateral" aria-controls="menuLateral" aria-label="Abrir menú"
        style="position:fixed;top:12px;right:12px;z-index:1030;width:44px;height:44px;font-size:1.25rem;line-height:1;">&#9776;</button>

<div class="offcanvas offcanvas-end" tabindex="-1" id="menuLateral" aria-labelledby="menuLateralTitulo" style="width:300px;">
  <div class="offcanvas-header border-bottom">
    <h5 class="offcanvas-title" id="menuLateralTitulo">Menú</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
  </div>
  <div class="offcanvas-body d-flex flex-column">
    <div class="d-flex align-items-center mb-4">
      <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3 flex-shrink-0"
           style="width:48px;height:48px;font-weight:600;"><%= iniciales %></div>
      <div class="text-start" style="min-width:0;">
        <div class="fw-semibold text-truncate"><%= nombre %></div>
        <div class="small text-muted text-truncate"><%= user.email %></div>
        <span class="badge <%= user.isAdmin ? 'text-bg-warning' : 'text-bg-secondary' %> mt-1"><%= user.isAdmin ? 'Administrador' : 'Usuario' %></span>
      </div>
    </div>

    <% if (panels && panels.length) { %>
      <div class="text-start text-uppercase small text-muted mb-1">Paneles</div>
      <div class="list-group mb-4 text-start">
        <% panels.forEach(function (p) { %>
          <a class="list-group-item list-group-item-action <%= p.key === current ? 'active' : '' %>" href="<%= p.path %>"><%= p.label %></a>
        <% }) %>
      </div>
    <% } %>

    <% if (user.isAdmin) { %>
      <div class="text-start text-uppercase small text-muted mb-1">Administración</div>
      <div class="list-group mb-4 text-start">
        <a class="list-group-item list-group-item-action" href="/api/user/register">Registrar usuario</a>
      </div>
    <% } %>

    <a class="btn btn-outline-danger mt-auto" href="/api/user/logout">Cerrar sesión</a>
  </div>
</div>
