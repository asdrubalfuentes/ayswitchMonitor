<%- include('head', {tituloweb: 'Cambia tu contraseña'}); %>
<body class="bg-light text-yellow text-center shadow-lg" onload="onload();">
<!--
    <div class="container-fluid p-5 bg-light text-primary text-center shadow-lg">
      <h1>Actualizar Contraseña</h1>
      <p class= "text-danger-emphasis">Actualiza la contraseña</p>
    </div>-->
      
    <div class="container-fluid p-2 bg-light text-Grey text-center shadow-lg">
      <div class="row" >
        <div class="col-sm-4">
    
        </div>
        <div class="col-sm-4">
            <div class="row">
                <div class="container mt-3">
                    <h3>Nueva Contraseña</h3>
                    <p>Introduzca su nueva Contraseña (mínimo 8 caracteres) y repítala</p>
                    <div id="msg"></div>
                      
                    <form action="/api/user/newpassword" class="was-validated" method="post" id="formConfirmPassword">
                      <div class="mb-3 mt-3">
                        <input type="password" class="form-control" id="pass1" placeholder="Introduzca Su nuevo password" name="passwd" required minlength="8" onkeyup = "revisaSimilar();">
                        <div class="valid-feedback"></div>
                        <div class="invalid-feedback">Requerido</div>
                      </div>
                      <div class="mb-3">
                        <input type="password" class="form-control" id="pass2" placeholder="Repita el Password" name="repasswd" required onkeyup = "revisaSimilar();"> 
                        <div class="valid-feedback"></div>
                        <div class="invalid-feedback">Requerido</div>
                      </div>
                      <input type="hidden" value="" id="token" name="token">
                    <button type="submit" class="btn btn-primary">Cambiar</button>
                    </form>
                  </div>
            </div>
    
        </div>
        <div class="col-sm-4">
        </div>
      </div>
    </div>
    <div class="mt-4 p-5 bg-LightGrey text-info rounded">
        <!---<h1>Aysafi</h1>
        <p class="text-warning">Sistemas electrónicos...</p>--->
        <img src="/static/LOGO.png" alt="" >
    </div>
    
    <script>
        const mensajeador = document.querySelector('#msg');

        function mostrar(texto, esError) {
            mensajeador.innerHTML = "";
            mensajeador.append(texto);
            mensajeador.setAttribute('style', esError ? "color:Red" : "color:Green");
        }

        // El token vive solo en el fragmento de la URL (no viaja al servidor)
        // y se quita de la barra de direcciones apenas se lee.
        function onload(){
            const token = new URLSearchParams(location.hash.slice(1)).get('token') || '';
            document.getElementById('token').value = token;
            history.replaceState(null, '', location.pathname);
            if (!token) mostrar('El enlace no es válido. Solicite uno nuevo.', true);
        }

        const formEditar = document.querySelector('#formConfirmPassword');

        formEditar.addEventListener('submit', async(e) => {
            e.preventDefault()
            const passwd = document.querySelector('#pass1').value
            const repasswd = document.querySelector('#pass2').value
            const token = document.querySelector('#token').value

            const data = await fetch(`/api/user/newpassword`, {
                method: 'POST',
                headers: {
                'Content-Type': 'application/json'
                },
                body: JSON.stringify({token, passwd, repasswd})
            })

            const res = await data.json()

            if(res.error==null){
                mostrar(res.data, false);
                setTimeout(() => { window.location.href = '/api/user/login' }, 2000);
            }else{
                mostrar(res.error, true);
            }
        })

        function revisaSimilar(){
            var password1 = document.getElementById('pass1');
            var password2 = document.getElementById('pass2');
            if (password1.value != password2.value) {
                password2.className = "form-control is-invalid"
            }else{
                password2.className = "form-control is-valid"
            }
        }
    </script>
    
    </body>
    </html>