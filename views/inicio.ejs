    });*/
        const deviceIdChapa = '94a53f';
        const TC_CHAPA = '/' + deviceIdChapa + '-comando';
        const deviceIdCorredera = '949a29';
        const TC_CORREDERA = '/' + deviceIdCorredera + '-comando';
        const TR_CHAPA = '/' + deviceIdChapa +'-respuesta';
        const TR_CORREDERA = '/' + deviceIdCorredera + '-respuesta';
        const TH_CHAPA = '/' + deviceIdChapa + '-heartBit';
        const TH_CORREDERA = '/' + deviceIdCorredera + '-heartBit';

        var spGiraPuerta1 = document.getElementById('spanIn');
        var spGiraPuerta2 = document.getElementById('spanOut');
        var botonPortonIn = document.getElementById('btnIn');
        var botonPortonOut = document.getElementById('btnOut');
        // Configura el cliente MQTT
        var client = mqtt.connect('ws://emqx.aysafi.com:8083/mqtt', {
            clientId: 'cliente-web-casaFuentes'
        });

        // Suscríbete a los tópicos
        client.on('connect', function () {
            console.log('Conexión exitosa al servidor MQTT');
            client.subscribe(TR_CHAPA, function (err) {
                if (!err) {
                    console.log('Suscripción exitosa al tópico' + TR_CHAPA);
                }
            });
	    client.subscribe(TR_CORREDERA, function(err){
		if(!err) {
		    console.log('Suscripción exitosa al tópico' + TR_CORREDERA);
		}
	    });

	    client.subscribe(TH_CHAPA, function (err) {
                if (!err) {
                    console.log('Suscripción exitosa al tópico' + TH_CHAPA);
                }
            });
            client.subscribe(TH_CORREDERA, function(err){
                if(!err) {
                    console.log('Suscripción exitosa al tópico' + TH_CORREDERA);
                }
            });         
         
        });
    
        // Maneja el mensaje recibido en el tópico
        client.on('message', function (topic, message) {
            // Aquí puedes manejar la lógica cuando llegue un mensaje al tópico
            var msg = message.toString();
	    var topic = topic.toString();
	    if(topic != TH_CHAPA || topic != TH_CORREDERA){
            	console.log('Mensaje recibido en el tópico ' + topic + ': ' + msg);
	    }
            if(topic == TR_CHAPA && msg == 'Puerta 1'){
                console.log("Chapa Recibio Orden de Accionamiento");
                spGiraPuerta1.className= 'spinner-border spinner-border text-danger';
                botonPortonIn.disabled = true;
                setTimeout(function(){
                    spGiraPuerta1.className = 'none';
                    console.log("Chapa lista para otro accionamiento");
                    botonPortonIn.disabled = false;
                }, 3000);
            }else if(topic == TR_CORREDERA && msg == 'Puerta 1'){
                console.log("Corredera Accionada");
                spGiraPuerta2.className= 'spinner-grow spinner-grow-sm text-info';
                //botonPortonOut.disabled = true;
                setTimeout(function(){
                    spGiraPuerta2.className = 'none';
                    console.log("Corredera Lista ");
                    //botonPortonOut.disabled = false;
                }, 3000);
            }else if(topic == TH_CHAPA && msg == 'up'){
		botonPortonIn.disabled = false;
	    }else if(topic == TH_CHAPA && msg == 'down'){
		botonPortonIn.disabled = true;
	    }else if(topic == TH_CORREDERA && msg == 'up'){
		botonPortonOut.disabled = false;
	    }else if(topic == TH_CORREDERA && msg == 'down'){
		botonPortonOut.disabled = true;
	    }
        });



        function execDoor(door){
            if(door == 'chapa'){
                console.log("Comando destrabar Chapa");
                //socket.emit('/testTopic', 'Rele 1 Pulsado');
                client.publish(TC_CHAPA, 'Rele Pulsado');
            }else if(door== 'corredera'){
                console.log("Comando Accionar Corredera");
                client.publish(TC_CORREDERA, 'Rele Pulsado');
            }
    
        }
    

    
</script>

</body>
</html>
